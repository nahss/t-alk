# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never put real keys in this file.
# The same names go into Vercel: Project → Settings → Environment Variables.
# None of these are used in the browser. Do not add a NEXT_PUBLIC_ prefix.

# Google Gemini (language detection + translation). From aistudio.google.com
GEMINI_API_KEY=

# YarnGPT (Pidgin voice). From yarngpt.ai, your account's API keys page
YARNGPT_API_KEY=

# Supabase (play log, public counter, rate limits). From your Supabase project
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Password for the private /test voice page (any username works).
# If this is blank, /test doesn't exist.
TEST_PAGE_PASSWORD=
